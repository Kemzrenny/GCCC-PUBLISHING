# Postgres (Neon), from the Neon/Vercel dashboard. Same setup as The Doer Life.
DATABASE_URL=

# Random secret that signs sign-in sessions. Required in production.
JWT_SECRET=

# Comma-separated emails that may create an account without an invite and are always
# admins. Put your own email here for the first sign-up.
ADMIN_EMAILS=

# Random secret Vercel Cron sends as a Bearer token. The portal also uses it to keep the
# transcription queue moving between requests.
CRON_SECRET=

# The portal's own address (optional on Vercel, where it's known automatically).
APP_URL=

# Vercel Blob: create a PRIVATE store in the Vercel project (Storage tab). Holds audio
# parts only while they're being transcribed.
BLOB_READ_WRITE_TOKEN=

# Podbean feed. The default is the GCCC feed; change it if the feed moves.
PODBEAN_FEED_URL=https://feed.podbean.com/gcccpodcasts/feed.xml
# Location given to new Podbean messages until someone edits it.
DEFAULT_LOCATION=Ojodu, Lagos, Nigeria

# Transcription services. Set the key for each one you want to try; pick the active one
# in Settings. Gemini also writes the summaries and themes.
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1

# Google Sheet mirror (optional). Create a service account in Google Cloud, enable the
# Sheets API, make a JSON key, and share the Publishing sheet with the service account's
# email as an Editor. The portal writes to its own tab and never touches the others.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=1GoEbG8UvD5rZrovCsxlIfp5rErNPa0ETl64iG1ewQ1E
GOOGLE_SHEET_TAB=Portal
